[Unit]
Description=fwatch - Automatic file organizer
Documentation=https://github.com/polarn/fwatch
After=network.target

[Service]
Type=simple
# Path the deb and AUR packages install the binary to.
# Adjust if you installed manually to /usr/local/bin.
ExecStart=/usr/bin/fwatch

# Restart policy
Restart=always
RestartSec=10

# Security hardening (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
